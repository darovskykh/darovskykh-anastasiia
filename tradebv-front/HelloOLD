// Типы данных
interface ImageData {
  id: string;
  binaryData: string; // base64 encoded image или URL
  name?: string;
  index?: number; // Оригинальный index из API (ID изображения)
}

interface ImageGroup {
  id: number;
  name: string;
  images: ImageData[];
}

interface ImagesData {
  groups: ImageGroup[];
  // Сохраняем дополнительные поля из payload, чтобы не потерять их при обновлении
  additionalPayloadFields?: {
    [key: string]: any;
  };
}

// Типы для API TradeBV
interface TradeBVFile {
  file_id: string;
  filename: string;
  group_id: string;
  content_type: string;
  size_bytes: number;
  uploaded_at: string;
  metadata?: {
    label?: string;
    [key: string]: any;
  };
  file_url: string;
}

interface TradeBVGetResponse {
  status: 'ok' | 'empty';
  request_id?: string;
  user_id?: string;
  payload_type?: string;
  payload?: {
    id?: string;
    groups?: {
      [groupId: string]: Array<{
        index: number;
        image_value: string; // base64 encoded image
      }>;
    };
    photo_groups?: Array<{
      group_id: string;
      files?: Array<{
        file_id: string;
        label?: string;
      }>;
      metadata?: any;
    }>;
    [key: string]: any;
  };
  expires_at?: string;
  files?: TradeBVFile[];
  message?: string;
}

const HelloPage: React.FC = () => {
  const [userName, setUserName] = useState<string | null>(null);
  const [imagesData, setImagesData] = useState<ImagesData>({ groups: [], additionalPayloadFields: {} });
  const [selectedImages, setSelectedImages] = useState<Array<{ image: ImageData; groupId: number }>>([]);
  const [viewImage, setViewImage] = useState<ImageData | null>(null);
  const [currentViewIndex, setCurrentViewIndex] = useState<number>(0);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [telegramUser, setTelegramUser] = useState<ReturnType<typeof getTelegramId>>(null);


  useEffect(() => {

    const userInfo = getTelegramId();

    setTelegramUser(userInfo);

    if (window.Telegram?.WebApp) {
      const tg = window.Telegram.WebApp;

      tg.ready();
      tg.expand();

      // Получаем информацию о пользователе
      const telegramUser = getTelegramUser();
      if (telegramUser) {
        console.log('Telegram user:', telegramUser);
        setUserName(telegramUser.first_name);
      }

      if (tg.themeParams.bg_color) {
        document.documentElement.style.setProperty('--tg-theme-bg-color', tg.themeParams.bg_color);
      }
      if (tg.themeParams.text_color) {
        document.documentElement.style.setProperty('--tg-theme-text-color', tg.themeParams.text_color);
      }
    }
  }, []);

  // Функция загрузки данных с сервера
  const loadData = async () => {
    const userId = getUserId();

    if (!userId) {
      console.error('User ID not found');
      const errorMsg = import.meta.env.DEV
        ? 'User ID not found. Add ?user_id=YOUR_ID to URL for development.'
        : 'User ID not found. Please open this page from Telegram.';
      setLoadError(errorMsg);
      return;
    }

    // Логируем для отладки
    console.log('loadData: userId =', userId);

    try {
      const response = await apiClient.get<TradeBVGetResponse>(`https://tradebv.gart.technology/api/v1/tradebv/get?user_id=${userId}`);

      // Обработка нового формата с payload.groups (group_images)
      if (response.payload_type === 'group_images' && response.payload?.groups) {
        const groups: ImageGroup[] = Object.entries(response.payload.groups).map(([groupId, images]) => ({
          id: Number(groupId) || Date.now(),
          name: `Group ${groupId}`,
          images: images.map((img) => {
            // Преобразуем base64 в data URL для отображения
            const base64Data = img.image_value;

            // Проверяем, есть ли уже префикс data:image
            if (base64Data.startsWith('data:image')) {
              return {
                id: `img-${groupId}-${img.index}`,
                binaryData: base64Data,
                name: `Image ${img.index + 1}`,
                index: img.index,
              };
            }

            // Определяем формат изображения по первым байтам base64
            // PNG начинается с iVBORw0KGgo, JPEG с /9j/4AAQ
            let imageType = 'image/png'; // по умолчанию PNG
            if (base64Data.startsWith('/9j/') || base64Data.startsWith('iVBORw0KGgo')) {
              // Если начинается с /9j/, это JPEG
              if (base64Data.startsWith('/9j/')) {
                imageType = 'image/jpeg';
              }
              // Если начинается с iVBORw0KGgo, это PNG (уже установлено)
            }

            const dataUrl = `data:${imageType};base64,${base64Data}`;

            return {
              id: `img-${groupId}-${img.index}`,
              binaryData: dataUrl,
              name: `Image ${img.index + 1}`,
              index: img.index,
            };
          }),
        }));

        // Сохраняем все дополнительные поля из payload, кроме groups
        const additionalPayloadFields: { [key: string]: any } = {};
        if (response.payload) {
          Object.keys(response.payload).forEach(key => {
            if (key !== 'groups') {
              additionalPayloadFields[key] = response.payload![key];
            }
          });
        }

        setImagesData({ groups, additionalPayloadFields });
        setLoadError(null);
        return;
      }

      // Обработка старого формата с files (для обратной совместимости)
      if (response.files && response.files.length > 0) {
        const filesByGroup = new Map<string, TradeBVFile[]>();
        response.files.forEach(file => {
          if (!filesByGroup.has(file.group_id)) {
            filesByGroup.set(file.group_id, []);
          }
          filesByGroup.get(file.group_id)!.push(file);
        });

        const groups: ImageGroup[] = Array.from(filesByGroup.entries()).map(([groupId, files]) => ({
          id: Number(groupId) || Date.now(),
          name: groupId,
          images: files.map(file => ({
            id: file.file_id,
            binaryData: file.file_url,
            name: file.metadata?.label || file.filename || file.file_id,
          })),
        }));

        setImagesData({ groups });
        setLoadError(null);
        return;
      }

      // Если данных нет
      setImagesData({ groups: [] });
      setLoadError(null);
    } catch (error) {
      console.error('Load data failed:', error);
      let errorMessage = 'Unknown error';
      if (error && typeof error === 'object' && 'message' in error) {
        errorMessage = (error as any).message;
        if ('details' in error && (error as any).details) {
          console.error('Error details:', (error as any).details);
        }
      } else if (error instanceof Error) {
        errorMessage = error.message;
      }
      setLoadError(errorMessage);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  const handleImageClick = (image: ImageData, groupId: number) => {
    setSelectedImages(prev => {
      // Проверяем, выбрана ли уже эта картинка (строгое сравнение по ID и groupId)
      const existingIndex = prev.findIndex(
        item => item.image.id === image.id && item.groupId === groupId
      );

      if (existingIndex !== -1) {
        // Убираем из выбранных
        const newSelection = prev.filter((_, index) => index !== existingIndex);
        return newSelection;
      } else {
        // Добавляем к выбранным
        return [...prev, { image, groupId }];
      }
    });
  };

  const handleViewImage = () => {
    if (selectedImages.length > 0) {
      // Показываем первую выбранную картинку
      setViewImage(selectedImages[0].image);
      setCurrentViewIndex(0);
    }
  };

  const handleNextImage = () => {
    if (selectedImages.length > 0 && currentViewIndex < selectedImages.length - 1) {
      const nextIndex = currentViewIndex + 1;
      setCurrentViewIndex(nextIndex);
      setViewImage(selectedImages[nextIndex].image);
    }
  };

  const handlePreviousImage = () => {
    if (selectedImages.length > 0 && currentViewIndex > 0) {
      const prevIndex = currentViewIndex - 1;
      setCurrentViewIndex(prevIndex);
      setViewImage(selectedImages[prevIndex].image);
    }
  };


  // Вспомогательная функция для преобразования imagesData в формат для API
  const prepareUploadData = (data: ImagesData) => {
    const groups: { [groupId: string]: Array<{ index: number; image_value: string }> } = {};

    data.groups.forEach((group) => {
      groups[group.id.toString()] = group.images.map((image, index) => {
        // Извлекаем base64 из binaryData (убираем префикс data:image/...;base64, если есть)
        let base64Data = image.binaryData;
        if (base64Data.startsWith('data:image')) {
          base64Data = base64Data.split(',')[1] || base64Data;
        }

        return {
          index,
          image_value: base64Data,
        };
      });
    });

    return groups;
  };

  // Вспомогательная функция для отправки данных на сервер
  const uploadGroupsData = async (data: ImagesData) => {
    setIsUploading(true);
    try {
      const userId = getUserId();

      if (!userId) {
        throw new Error('User ID not found. Please open this page from Telegram.');
      }

      const requestId = userId;

      const groups = prepareUploadData(data);

      // Создаем payload, объединяя groups и сохраненные дополнительные поля
      const payloadData: any = {
        id: userId,
        prompt: "Mock grouping",
        groups: groups,
        // Добавляем сохраненные дополнительные поля (включая function_2_kwargs)
        ...(data.additionalPayloadFields || {}),
      };

      const payload = {
        request_id: requestId,
        user_id: userId,
        payload_type: 'group_images',
        payload: payloadData,
      };


      const response = await apiClient.post<TradeBVGetResponse>(
        `https://tradebv.gart.technology/api/v1/tradebv/upload`,
        payload
      );



      try {
        if (response){
          await loadData();
        }
      } catch (loadError) {
        console.error('Error in loadData() after uploadGroupsData:', loadError);
      }

      return response;
    } catch (error) {
      console.error('Upload failed:', error);

      // Показываем уведомление об ошибке
      let errorMessage = 'Unknown error';
      if (error && typeof error === 'object' && 'message' in error) {
        errorMessage = (error as any).message;
        if ('details' in error && (error as any).details) {
          console.error('Error details:', (error as any).details);
        }
      } else if (error instanceof Error) {
        errorMessage = error.message;
      }

      if (window.Telegram?.WebApp) {
        window.Telegram.WebApp.showAlert(`Upload error: ${errorMessage}`);
      } else {
        alert(`Upload error: ${errorMessage}`);
      }
      throw error;
    } finally {
      setIsUploading(false);
    }
  };

  const handleMoveToPreviousGroup = async () => {
    if (selectedImages.length === 0) return;

    // Находим минимальный индекс группы среди выбранных изображений
    const currentGroupIndices = selectedImages.map(item => {
      return imagesData.groups.findIndex(group => group.id === item.groupId);
    });

    const minGroupIndex = Math.min(...currentGroupIndices);

    // Если уже в первой группе, ничего не делаем
    if (minGroupIndex <= 0) {
      if (window.Telegram?.WebApp) {
        window.Telegram.WebApp.showAlert('Images are already in the first group');
      } else {
        alert('Images are already in the first group');
      }
      return;
    }

    const targetGroup = imagesData.groups[minGroupIndex - 1];

    // Подготавливаем новые данные для перемещения
    const newGroups = imagesData.groups.map(group => ({
      ...group,
      images: [...group.images],
    }));

    // Сохраняем исходное состояние для отката в случае ошибки
    const originalGroups = imagesData.groups.map(group => ({
      ...group,
      images: [...group.images],
    }));
    const originalSelectedImages = [...selectedImages];

    // Перемещаем выбранные изображения в предыдущую группу
    selectedImages.forEach(({ image, groupId }) => {
      const sourceGroupIndex = newGroups.findIndex(g => g.id === groupId);
      if (sourceGroupIndex === -1) return;

      const sourceGroup = newGroups[sourceGroupIndex];
      const imageIndex = sourceGroup.images.findIndex(img => img.id === image.id);
      if (imageIndex === -1) return;

      // Удаляем изображение из исходной группы
      const [movedImage] = sourceGroup.images.splice(imageIndex, 1);

      // Добавляем в целевую группу
      const targetGroupIndex = newGroups.findIndex(g => g.id === targetGroup.id);
      if (targetGroupIndex !== -1) {
        newGroups[targetGroupIndex].images.push(movedImage);
      }
    });

    // Обновляем selectedImages с новыми groupId
    setSelectedImages(prev =>
      prev.map(item => ({
        ...item,
        groupId: targetGroup.id,
      }))
    );

    // Удаляем пустые группы
    const filteredGroups = newGroups.filter(group => group.images.length > 0);

    // Оптимистично обновляем состояние для лучшего UX, сохраняя additionalPayloadFields
    setImagesData({ groups: filteredGroups, additionalPayloadFields: imagesData.additionalPayloadFields });

    // Отправляем обновленные данные на сервер
    try {
      await uploadGroupsData({ groups: filteredGroups, additionalPayloadFields: imagesData.additionalPayloadFields });
      // После успешной загрузки данные обновятся с сервера через loadData() в uploadGroupsData
      // Очищаем выбор, так как данные обновятся с сервера
      setSelectedImages([]);
    } catch (error) {
      // В случае ошибки откатываем изменения
      console.error('Failed to upload, reverting changes:', error);
      setImagesData({ groups: originalGroups, additionalPayloadFields: imagesData.additionalPayloadFields });
      setSelectedImages(originalSelectedImages); // Восстанавливаем исходный выбор
    }
  };

  const handleMoveToNextGroup = async () => {
    if (selectedImages.length === 0) return;

    // Находим максимальный индекс группы среди выбранных изображений
    const currentGroupIndices = selectedImages.map(item => {
      return imagesData.groups.findIndex(group => group.id === item.groupId);
    });

    const maxGroupIndex = Math.max(...currentGroupIndices);

    // Подготавливаем новые данные для перемещения
    const newGroups = imagesData.groups.map(group => ({
      ...group,
      images: [...group.images],
    }));

    let targetGroup: ImageGroup;

    // Если уже в последней группе, создаем новую группу
    if (maxGroupIndex >= imagesData.groups.length - 1) {
      // Генерируем уникальный числовой ID для новой группы
      const newGroupId = Date.now();

      // Находим максимальный номер группы для правильного именования
      const existingGroupNumbers = newGroups
        .map(g => {
          const match = g.name.match(/Group (\d+)/);
          return match ? parseInt(match[1], 10) : 0;
        })
        .filter(n => n > 0);
      const maxGroupNumber = existingGroupNumbers.length > 0
        ? Math.max(...existingGroupNumbers)
        : newGroups.length;
      const newGroupNumber = maxGroupNumber + 1;

      // Создаем новую группу
      targetGroup = {
        id: newGroupId,
        name: `Group ${newGroupNumber}`,
        images: [],
      };

      // Добавляем новую группу в массив
      newGroups.push(targetGroup);
    } else {
      // Находим целевую группу в newGroups (она уже скопирована)
      const targetGroupIndex = maxGroupIndex + 1;
      targetGroup = newGroups[targetGroupIndex];
    }

    // Сохраняем исходное состояние для отката в случае ошибки
    const originalGroups = imagesData.groups.map(group => ({
      ...group,
      images: [...group.images],
    }));
    const originalSelectedImages = [...selectedImages];

    // Перемещаем выбранные изображения в следующую группу
    selectedImages.forEach(({ image, groupId }) => {
      const sourceGroupIndex = newGroups.findIndex(g => g.id === groupId);
      if (sourceGroupIndex === -1) return;

      const sourceGroup = newGroups[sourceGroupIndex];
      const imageIndex = sourceGroup.images.findIndex(img => img.id === image.id);
      if (imageIndex === -1) return;

      // Удаляем изображение из исходной группы
      const [movedImage] = sourceGroup.images.splice(imageIndex, 1);

      // Добавляем в целевую группу
      const targetGroupIndex = newGroups.findIndex(g => g.id === targetGroup.id);
      if (targetGroupIndex !== -1) {
        newGroups[targetGroupIndex].images.push(movedImage);
      }
    });

    setSelectedImages(prev =>
      prev.map(item => ({
        ...item,
        groupId: targetGroup.id,
      }))
    );

    // Удаляем пустые группы
    const filteredGroups = newGroups.filter(group => group.images.length > 0);

    // Оптимистично обновляем состояние для лучшего UX, сохраняя additionalPayloadFields
    setImagesData({ groups: filteredGroups, additionalPayloadFields: imagesData.additionalPayloadFields });

    try {
      await uploadGroupsData({ groups: filteredGroups, additionalPayloadFields: imagesData.additionalPayloadFields });
      setSelectedImages([]);
    } catch (error) {
      setImagesData({ groups: originalGroups, additionalPayloadFields: imagesData.additionalPayloadFields });
      setSelectedImages(originalSelectedImages);
    }
  };

  const handleSubmit = async () => {
    setIsSubmitting(true);
    try {
      const userId = getUserId();

      if (!userId) {
        throw new Error('User ID not found. Please open this page from Telegram.');
      }

      // Сначала загружаем текущие данные на сервер
      await uploadGroupsData(imagesData);

      // Затем отправляем confirm
      const requestId = userId;

      const payload = {
        request_id: requestId,
      };

      const response = await apiClient.post<{ status: string; request_id: string; extract_data_status?: number; confirmation_message?: string }>(
        `https://tradebv.gart.technology/api/v1/tradebv/confirm`,
        payload
      );

      console.log('Confirm successful:', response);

      // Удаляем фото из интерфейса
      setImagesData({ groups: [] });
      setSelectedImages([]);

      // Показываем сообщение из JSON ответа или дефолтное сообщение
      const confirmMessage = response.confirmation_message || 'Changes confirmed successfully!';

      if (window.Telegram?.WebApp) {
        window.Telegram.WebApp.showAlert(confirmMessage);
      } else {
        alert(confirmMessage);
      }
    } catch (error) {
      console.error('Confirm failed:', error);

      // Показываем уведомление об ошибке
      let errorMessage = 'Unknown error';
      if (error && typeof error === 'object' && 'message' in error) {
        errorMessage = (error as any).message;
        // Если есть дополнительные детали, добавляем их
        if ('details' in error && (error as any).details) {
          console.error('Error details:', (error as any).details);
        }
      } else if (error instanceof Error) {
        errorMessage = error.message;
      }

      if (window.Telegram?.WebApp) {
        window.Telegram.WebApp.showAlert(`Confirm error: ${errorMessage}`);
      } else {
        alert(`Confirm error: ${errorMessage}`);
      }
    } finally {
      setIsSubmitting(false);
    }
  };



  return (
    <div className="min-h-screen bg-gradient-subtle p-4">
      {/* Версия приложения */}
      <div className="fixed top-2 right-2 z-[5] text-[10px] text-muted-foreground/50">
        v1.0.1
      </div>

      <div className="max-w-7xl mx-auto pt-4 pb-24 sm:pb-28">
        {userName && (
          <div className="mb-6">
            <p className="text-muted-foreground">userID: {getUserId()}</p>
            {import.meta.env.DEV && telegramUser?.webAppInfo?.version === 'dev' && (
              <div className="mt-2 p-2 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded text-xs">
                <span className="font-semibold text-blue-800 dark:text-blue-200">🛠️ Dev Mode:</span>{' '}
                <span className="text-blue-700 dark:text-blue-300">
                  Using URL parameters. Change via: <code className="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">?user_id=YOUR_ID&first_name=Name</code>
                </span>
              </div>
            )}
          </div>
        )}

        {isUploading && (
          <div className="mb-4 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg flex items-center gap-2">
            <Loader2 className="h-4 w-4 animate-spin text-blue-600 dark:text-blue-400" />
            <p className="text-sm text-blue-800 dark:text-blue-200">Saving changes...</p>
          </div>
        )}

        {loadError && (
          <div className="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
            <p className="text-sm text-red-800 dark:text-red-200">{loadError}</p>
          </div>
        )}

        {/* Image Groups */}
        {!loadError && (
          imagesData.groups.length === 0 ? (
            <div className="text-center py-12">
              <p className="text-muted-foreground">No data to display</p>
            </div>
          ) : (
            <div className="space-y-6">
              {imagesData.groups.map((group) => (
                <Card key={group.id}>
                  <CardHeader className="p-4 sm:p-6">
                    <CardTitle className="flex items-center justify-between text-base sm:text-lg">
                      <span>{group.name}</span>
                      <Badge variant="secondary" className="text-xs sm:text-sm">{group.images.length} images</Badge>
                    </CardTitle>
                  </CardHeader>
                  <CardContent className="p-4 sm:p-6">
                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2 sm:gap-4">
                      {group.images.map((image) => {
                        const isSelected = selectedImages.some(
                          item => item.image.id === image.id && item.groupId === group.id
                        );

                        return (
                          <div
                            key={`${group.id}-${image.id}`}
                            className={`relative group cursor-pointer rounded-lg overflow-hidden border-2 transition-all ${
                              isSelected
                                ? 'border-primary ring-2 ring-primary'
                                : 'border-border hover:border-primary/50'
                            }`}
                            onClick={() => handleImageClick(image, group.id)}
                          >
                            <div className="aspect-square bg-muted flex items-center justify-center relative overflow-hidden">
                              <img
                                src={image.binaryData}
                                alt={image.name || image.id}
                                className="w-full h-full object-cover"
                              />
                              {isSelected && (
                                <div className="absolute inset-0 bg-black/20 flex items-center justify-center pointer-events-none">
                                  <ImageIcon className="h-8 w-8 text-white" />
                                </div>
                              )}
                            </div>
                            {isSelected && (
                              <div className="absolute top-2 right-2 z-10">
                                <Badge className="bg-primary">
                                  <Check className="h-3 w-3 mr-1" />
                                  Selected
                                </Badge>
                              </div>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          )
        )}


        {/* Кнопка подтверждения изменений - всегда видна */}
        <div className="fixed bottom-2 left-2 right-2 sm:bottom-4 sm:left-4 sm:right-4 z-20">
          <Button
            onClick={handleSubmit}
            disabled={isSubmitting}
            size="lg"
            className="shadow-lg bg-green-600 hover:bg-green-700 text-white border-0 transition-all duration-200 hover:shadow-xl hover:scale-105 disabled:hover:scale-100 disabled:opacity-70 w-full text-sm sm:text-base px-4 sm:px-6"
          >
            {isSubmitting ? (
              <>
                <Loader2 className="h-4 w-4 mr-2 animate-spin" />
                Saving...
              </>
            ) : (
              <>
                <Check className="h-4 w-4 mr-2" />
                <span className="hidden sm:inline">Confirm Changes</span>
                <span className="sm:hidden">Confirm</span>
              </>
            )}
          </Button>
        </div>

        {/* Кнопки управления (показываются при выборе изображений) */}
        {selectedImages.length > 0 && (
          <div className="fixed bottom-14 sm:bottom-20 left-1/2 transform -translate-x-1/2 z-10 w-[calc(100%-2rem)] sm:w-auto max-w-md">
            <Card className="shadow-xl border">
              <CardContent className="p-2 sm:p-2.5">
                <div className="flex items-center gap-1.5 sm:gap-2.5 flex-wrap sm:flex-nowrap justify-center sm:justify-start">
                  <div className="flex items-center justify-center min-w-[32px] h-9 px-2 sm:px-2.5 bg-primary/10 rounded-md">
                    <span className="text-sm font-semibold text-primary">
                      {selectedImages.length}
                    </span>
                  </div>
                  <div className="h-6 w-px bg-border hidden sm:block" />
                  <Button
                    onClick={handleViewImage}
                    variant="default"
                    size="sm"
                    className="h-9 px-3 sm:px-4 text-xs sm:text-sm"
                    disabled={selectedImages.length === 0}
                  >
                    <ImageIcon className="h-4 w-4 sm:mr-2" />
                    <span className="hidden sm:inline">View</span>
                  </Button>
                  <div className="h-6 w-px bg-border hidden sm:block" />
                  <div className="flex items-center gap-1">
                    <Button
                      onClick={handleMoveToPreviousGroup}
                      variant="outline"
                      size="icon"
                      className="h-9 w-9"
                      disabled={
                        isUploading ||
                        selectedImages.length === 0 ||
                        selectedImages.every(item => imagesData.groups.findIndex(group => group.id === item.groupId) === 0)
                      }
                      title="Move to previous group"
                    >
                      {isUploading ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <ChevronLeft className="h-4 w-4" />
                      )}
                    </Button>
                    <Button
                      onClick={handleMoveToNextGroup}
                      variant="outline"
                      size="icon"
                      className="h-9 w-9"
                      disabled={isUploading || selectedImages.length === 0}
                      title="Move to next group"
                    >
                      {isUploading ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <ChevronRight className="h-4 w-4" />
                      )}
                    </Button>
                  </div>
                  <div className="h-6 w-px bg-border hidden sm:block" />
                  <Button
                    onClick={() => setSelectedImages([])}
                    variant="ghost"
                    size="icon"
                    className="h-9 w-9 hover:bg-destructive/10 hover:text-destructive"
                    title="Clear selection"
                  >
                    <X className="h-4 w-4" />
                  </Button>
                </div>
              </CardContent>
            </Card>
          </div>
        )}
      </div>

      {/* Модальное окно просмотра изображения */}
      <Dialog open={!!viewImage} onOpenChange={(open) => {
        if (!open) {
          setViewImage(null);
          setCurrentViewIndex(0);
        }
      }}>
        <DialogContent className="max-w-7xl w-[95vw] sm:w-[90vw] max-h-[95vh] p-0">
          <DialogHeader className="p-4 sm:p-6 pb-3 sm:pb-4">
            <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-0">
              <div className="flex items-center gap-2 sm:gap-4">
                <DialogTitle className="text-base sm:text-lg">
                  {viewImage?.name || 'View Image'}
                  {selectedImages.length > 1 && (
                    <span className="text-xs sm:text-sm font-normal text-muted-foreground ml-2">
                      ({currentViewIndex + 1} / {selectedImages.length})
                    </span>
                  )}
                </DialogTitle>
              </div>
              <div className="flex items-center gap-2 w-full sm:w-auto justify-end">
                {selectedImages.length > 1 && (
                  <>
                    <Button
                      onClick={handlePreviousImage}
                      variant="outline"
                      size="icon"
                      disabled={currentViewIndex === 0}
                      title="Previous image"
                      className="h-9 w-9"
                    >
                      <ChevronLeft className="h-4 w-4" />
                    </Button>
                    <Button
                      onClick={handleNextImage}
                      variant="outline"
                      size="icon"
                      disabled={currentViewIndex === selectedImages.length - 1}
                      title="Next image"
                      className="h-9 w-9"
                    >
                      <ChevronRight className="h-4 w-4" />
                    </Button>
                  </>
                )}
                <Button onClick={() => {}} variant="default" size="sm" className="h-9 text-xs sm:text-sm px-3 sm:px-4">
                  <Download className="h-4 w-4 mr-1 sm:mr-2" />
                  <span className="hidden sm:inline">Download</span>
                  <span className="sm:hidden">DL</span>
                </Button>
              </div>
            </div>
          </DialogHeader>
          {viewImage && (
            <div className="relative w-full h-[calc(95vh-100px)] sm:h-[calc(95vh-120px)] overflow-auto bg-muted">
              <div className="flex items-center justify-center min-h-full p-2 sm:p-4">
                <img
                  src={viewImage.binaryData}
                  alt={viewImage.name || viewImage.id}
                  className="max-w-full max-h-full object-contain rounded-lg"
                  style={{
                    touchAction: 'pan-x pan-y pinch-zoom',
                    userSelect: 'none',
                  }}
                  draggable={false}
                />
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>
    </div>
  );
};

export default HelloPage;

